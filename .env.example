DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=

POSTGRES_DB=verdant
POSTGRES_USER=verdant
POSTGRES_PASSWORD=verdant
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Szyfrowanie danych dostępowych integracji (wymagane na produkcji).
# Wygeneruj: python manage.py generate_encryption_key
# Rotacja: klucze po przecinku, nowy jako pierwszy.
DJANGO_FIELD_ENCRYPTION_KEY=

# Integracja Allegro.
# Adres musi być zarejestrowany w panelu deweloperskim Allegro — osobno dla
# sandboxa i produkcji, i identyczny z tym, którego używa aplikacja.
ALLEGRO_REDIRECT_URI=http://localhost:8000/marketplaces/oauth/callback/

# Adres do powiadomień o błędach importu, gdy integracja nie ma własnego.
DJANGO_ADMIN_NOTIFICATION_EMAIL=
